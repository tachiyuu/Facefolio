<?xml version="1.0" encoding="utf-8"?>
<!-- System splash icon: filled with the splash background so it is invisible. It must not be empty:
     Android 12+ treats an empty icon as unset and draws the launcher icon instead, which then jumps
     to the tile SplashLoading draws. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/splash_background"
        android:pathData="M0,0h108v108h-108z" />
</vector>
